# Mysql env
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dst
MYSQL_USER=admin
MYSQL_PASSWORD=admin

# PostgreSQL env（密碼請用 openssl rand -hex 24 產生，避免網址特殊字元）
POSTGRES_DB=dst
POSTGRES_USER=dst
POSTGRES_PASSWORD=

# Python env
PORT=5000
SECRET_KEY=type-your-secret
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
JWT_SECRET_KEY=type-your-secret
DST_MSSQL=
DEBUG=False

# System
TZ=Asia/Taipei

# Mysql env
MYSQL_ROOT_PASSWORD=CHANGE_ME_generate_a_long_random_value
MYSQL_DATABASE=dst
MYSQL_USER=admin
MYSQL_PASSWORD=CHANGE_ME_generate_a_long_random_value

# PostgreSQL env（密碼請用 openssl rand -hex 24 產生，避免網址特殊字元）
POSTGRES_DB=dst
POSTGRES_USER=dst
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_value

# Python env
PORT=5000
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
DST_MSSQL=Driver={FreeTDS};Server=<host>;port=<port>;UID=<user>;PWD=<password>;Database=<db>
DEBUG=False

# System
TZ=Asia/Taipei
